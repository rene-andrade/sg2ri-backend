# Ambiente: development | production | test
NODE_ENV=development
PORT=3000

# Conexão PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sg2ri?schema=public"

# Autenticação JWT
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN="http://localhost:5173"

# Administrador inicial criado pelo seed (npm run db:seed)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@sg2ri.edu.br"
ADMIN_PASSWORD="admin1234"

# E-mail das notificações (opcional). Sem SMTP_HOST, as mensagens só vão para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SG2RI <no-reply@sg2ri.edu.br>"
